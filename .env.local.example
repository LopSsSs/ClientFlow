# Neon PostgreSQL
DATABASE_URL=postgresql://neondb_owner:password@host:5432/clientflow?sslmode=require

# JWT Secret (genera uno: openssl rand -base64 32)
JWT_SECRET=your-secret-key-here

# Stripe (recomendado: una restricted key rk_test_... con permisos mínimos
# de Checkout Sessions, en vez de la secret key completa sk_test_...)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-key
STRIPE_SECRET_KEY=sk_test_your-key
# Firma del webhook (stripe listen --forward-to localhost:3000/api/webhooks/stripe)
STRIPE_WEBHOOK_SECRET=whsec_your-key

# Resend (para emails)
RESEND_API_KEY=re_your-key
# Remitente de los emails transaccionales (verificación, etc.). Opcional en dev.
EMAIL_FROM=ClientFlow <onboarding@resend.dev>

# Twilio (recordatorios por SMS/WhatsApp). Sin esto, los envíos solo se registran en consola.
TWILIO_ACCOUNT_SID=ACyour-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_SMS_FROM=+15551234567
# Número de sandbox de WhatsApp de Twilio, o tu número aprobado en producción.
TWILIO_WHATSAPP_FROM=+14155238886

# Autoriza las llamadas al endpoint de automatización (/api/cron/run-automations).
# Genera uno: openssl rand -hex 32
CRON_SECRET=your-cron-secret

# Vercel Blob (fotos de antes/después). Se crea al enlazar un Vercel Blob store
# a tu proyecto: vercel.com/docs/storage/vercel-blob
BLOB_READ_WRITE_TOKEN=your-blob-token

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

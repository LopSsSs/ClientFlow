# Base de datos (Neon Postgres)
DATABASE_URL=postgresql://...

# Auth
JWT_SECRET=...

# Email transaccional (verificación, facturas, recordatorios)
# Gmail SMTP tiene prioridad si está configurado: entrega a cualquier
# destinatario real sin verificar un dominio (a diferencia de Resend en modo
# sandbox). GMAIL_APP_PASSWORD es una "contraseña de aplicación" generada en
# la cuenta de Google (myaccount.google.com/apppasswords, requiere
# verificación en 2 pasos activada) — no la contraseña normal de la cuenta.
GMAIL_USER=clientflow182@gmail.com
GMAIL_APP_PASSWORD=...
RESEND_API_KEY=...
EMAIL_FROM=ClientFlow <onboarding@resend.dev>

# SMS / WhatsApp (Twilio)
TWILIO_ACCOUNT_SID=...
TWILIO_AUTH_TOKEN=...
TWILIO_SMS_FROM=...
TWILIO_WHATSAPP_FROM=...

# WhatsApp vía Make (automatizaciones)
MAKE_WEBHOOK_SECRET=...
MAKE_WHATSAPP_WEBHOOK_URL=https://hook.make.com/...

# Stripe (suscripciones y cobro de facturas)
STRIPE_SECRET_KEY=sk_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Almacenamiento de archivos (fotos de trabajos, logo de facturas)
BLOB_READ_WRITE_TOKEN=...

# Cron jobs internos (recordatorios automáticos)
CRON_SECRET=...

# App
NEXT_PUBLIC_APP_URL=https://clientflow-nine-gold.vercel.app
